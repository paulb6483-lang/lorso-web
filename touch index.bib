touch index.html<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>L’Orso | Catering & Repostería</title>
  <meta name="description" content="L’Orso Catering. Panadería, repostería y catering para eventos, restaurantes y cafeterías.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --negro-profundo: #0F1210;
      --negro: #1F1F1B;
      --beige: #C8B197;
      --crema: #EAE2D4;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Montserrat", sans-serif;
      font-weight: 300;
      background: var(--crema);
      color: var(--negro-profundo);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select,
    textarea {
      font-family: "Montserrat", sans-serif;
    }

    button {
      cursor: pointer;
    }

    .container {
      width: min(1120px, calc(100% - 40px));
      margin: auto;
    }

    /* NAVBAR */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(234, 226, 212, 0.96);
      border-bottom: 1px solid var(--beige);
      backdrop-filter: blur(8px);
    }

    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .logo {
      font-family: "Montserrat", sans-serif;
      font-size: 27px;
      font-weight: 400;
      letter-spacing: 3px;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 25px;
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .nav-links a {
      transition: opacity .2s;
    }

    .nav-links a:hover {
      opacity: .55;
    }

    .nav-button {
      background: var(--negro-profundo);
      color: var(--crema);
      padding: 12px 18px;
      border: none;
      border-radius: 2px;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* HERO */
    .hero {
      min-height: 650px;
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      align-items: center;
      gap: 70px;
      padding: 70px 0;
    }

    .eyebrow {
      font-size: 11px;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--negro);
      margin-bottom: 18px;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      font-family: "Montserrat", sans-serif;
      font-weight: 400;
      letter-spacing: 3px;
    }

    h1 {
      font-size: clamp(48px, 6.5vw, 82px);
      line-height: .98;
      margin-bottom: 30px;
    }

    .hero-text {
      max-width: 530px;
      font-size: 18px;
      line-height: 1.7;
      letter-spacing: 2px;
      color: var(--negro);
    }

    .hero-buttons {
      display: flex;
      gap: 12px;
      margin-top: 32px;
      flex-wrap: wrap;
    }

    .button-primary,
    .button-secondary {
      padding: 14px 22px;
      border-radius: 2px;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
      border: 1px solid var(--negro-profundo);
    }

    .button-primary {
      background: var(--negro-profundo);
      color: var(--crema);
    }

    .button-secondary {
      background: transparent;
      color: var(--negro-profundo);
    }

    .hero-image {
      min-height: 500px;
      background:
        linear-gradient(0deg, rgba(15,18,16,.55), transparent 65%),
        url("https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=1200&q=85");
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: flex-end;
      padding: 30px;
      color: var(--crema);
    }

    .hero-image span {
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 3px;
    }

    /* SECTIONS */
    section {
      padding: 90px 0;
      border-top: 1px solid var(--beige);
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 30px;
      margin-bottom: 40px;
    }

    h2 {
      font-size: clamp(34px, 5vw, 56px);
      line-height: 1;
    }

    .section-description {
      max-width: 440px;
      color: var(--negro);
      font-size: 14px;
      font-weight: 300;
      line-height: 1.8;
      letter-spacing: 2px;
    }

    /* CATEGORIES */
    .categories {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .category {
      min-height: 330px;
      padding: 30px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      position: relative;
      overflow: hidden;
      color: var(--crema);
    }

    .category:nth-child(1) {
      background:
        linear-gradient(0deg, rgba(15,18,16,.75), transparent),
        url("https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=900&q=80") center/cover;
    }

    .category:nth-child(2) {
      background:
        linear-gradient(0deg, rgba(15,18,16,.75), transparent),
        url("https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=900&q=80") center/cover;
    }

    .category:nth-child(3) {
      background:
        linear-gradient(0deg, rgba(15,18,16,.75), transparent),
        url("https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=900&q=80") center/cover;
    }

    .category h3 {
      font-size: 28px;
      margin-bottom: 10px;
    }

    .category p {
      font-size: 12px;
      line-height: 1.7;
      letter-spacing: 1.5px;
    }

    /* PRODUCTS */
    .products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .product {
      background: var(--beige);
    }

    .product-image {
      height: 260px;
      background-size: cover;
      background-position: center;
    }

    .product:nth-child(1) .product-image {
      background-image: url("https://images.unsplash.com/photo-1623334044303-241021148842?auto=format&fit=crop&w=900&q=80");
    }

    .product:nth-child(2) .product-image {
      background-image: url("https://images.unsplash.com/photo-1509365465985-25d11c17e812?auto=format&fit=crop&w=900&q=80");
    }

    .product:nth-child(3) .product-image {
      background-image: url("https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=900&q=80");
    }

    .product:nth-child(4) .product-image {
      background-image: url("https://images.unsplash.com/photo-1499636136210-6f4ee915583e?auto=format&fit=crop&w=900&q=80");
    }

    .product:nth-child(5) .product-image {
      background-image: url("https://images.unsplash.com/photo-1565958011703-44f9829ba187?auto=format&fit=crop&w=900&q=80");
    }

    .product:nth-child(6) .product-image {
      background-image: url("https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=900&q=80");
    }

    .product-info {
      padding: 20px;
    }

    .product-info h3 {
      font-size: 22px;
      margin-bottom: 8px;
    }

    .product-info p {
      color: var(--negro);
      font-size: 12px;
      line-height: 1.7;
      letter-spacing: 1.5px;
    }

    /* SERVICES */
    .services {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 40px;
    }

    .service {
      padding: 45px;
      background: var(--beige);
    }

    .service h3 {
      font-size: 32px;
      margin-bottom: 18px;
    }

    .service p {
      color: var(--negro);
      line-height: 1.8;
      font-size: 13px;
      letter-spacing: 1.5px;
    }

    .service-link {
      display: inline-block;
      margin-top: 25px;
      border-bottom: 1px solid var(--negro-profundo);
      padding-bottom: 4px;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* QUOTE */
    .quote-section {
      background: var(--beige);
    }

    .quote-layout {
      display: grid;
      grid-template-columns: .75fr 1.25fr;
      gap: 70px;
    }

    .quote-intro p {
      margin-top: 20px;
      color: var(--negro);
      line-height: 1.8;
      font-size: 14px;
      letter-spacing: 2px;
    }

    .quote-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    .form-group label {
      font-size: 10px;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 14px;
      border: 1px solid var(--negro);
      background: var(--crema);
      color: var(--negro-profundo);
      font-size: 14px;
      font-weight: 300;
      letter-spacing: 1px;
      border-radius: 2px;
      outline: none;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--negro-profundo);
    }

    .form-group textarea {
      min-height: 130px;
      resize: vertical;
    }

    .submit {
      background: var(--negro-profundo);
      color: var(--crema);
      border: none;
      padding: 15px 24px;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* SOCIAL */
    .social-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 35px;
    }

    .social {
      min-width: 180px;
      padding: 20px;
      border: 1px solid var(--beige);
      background: var(--beige);
      transition: background .2s;
    }

    .social:hover {
      background: var(--crema);
    }

    .social strong {
      display: block;
      font-size: 17px;
      font-weight: 400;
      letter-spacing: 2px;
      margin-bottom: 5px;
    }

    .social span {
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 1.5px;
    }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--beige);
      padding: 50px 0;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      gap: 30px;
      flex-wrap: wrap;
    }

    .footer-text {
      color: var(--negro);
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 2px;
      margin-top: 10px;
    }

    /* MOBILE */
    @media (max-width: 800px) {
      .nav-links {
        display: none;
      }

      .hero {
        grid-template-columns: 1fr;
        gap: 40px;
        padding: 55px 0;
      }

      .hero-image {
        min-height: 380px;
      }

      .categories,
      .products,
      .services,
      .quote-layout {
        grid-template-columns: 1fr;
      }

      .section-header {
        display: block;
      }

      .section-description {
        margin-top: 15px;
      }

      .quote-layout {
        gap: 40px;
      }

      .quote-form {
        grid-template-columns: 1fr;
      }

      .form-group.full {
        grid-column: auto;
      }

      section {
        padding: 65px 0;
      }
    }

    @media (max-width: 480px) {
      .container {
        width: min(100% - 28px, 1120px);
      }

      .logo {
        font-size: 22px;
      }

      .nav-button {
        padding: 10px 13px;
      }

      h1 {
        font-size: 48px;
      }

      .hero-text {
        font-size: 16px;
      }

      .service {
        padding: 30px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="container nav">
    <a href="#" class="logo">L’ORSO</a>

    <nav class="nav-links">
      <a href="#catalogo">Catálogo</a>
      <a href="#productos">Productos</a>
      <a href="#servicios">Servicios</a>
      <a href="#cotizar">Cotizar</a>
    </nav>

    <a href="#cotizar" class="nav-button">Solicitar cotización</a>
  </div>
</header>

<main>

  <!-- HERO -->
  <div class="container">
    <section class="hero" style="border-top:none;">

      <div>
        <div class="eyebrow">Panadería · Repostería · Catering</div>

        <h1>Cocina hecha para compartir.</h1>

        <p class="hero-text">
          L’Orso desarrolla productos de panadería, repostería
          y propuestas gastronómicas para restaurantes,
          cafeterías y eventos.
        </p>

        <div class="hero-buttons">
          <a href="#catalogo" class="button-primary">Ver catálogo</a>
          <a href="#cotizar" class="button-secondary">Cotizar un evento</a>
        </div>
      </div>

      <div class="hero-image">
        <span>L’ORSO CATERING</span>
      </div>

    </section>
  </div>

  <!-- CATALOGO -->
  <section id="catalogo">
    <div class="container">

      <div class="section-header">
        <div>
          <div class="eyebrow">Nuestra propuesta</div>
          <h2>Catálogo</h2>
        </div>

        <p class="section-description">
          Productos elaborados para venta,
          servicio gastronómico y eventos.
        </p>
      </div>

      <div class="categories">

        <article class="category">
          <h3>Panadería</h3>
          <p>Brioche, baguette, ciabatta, roles y piezas especiales.</p>
        </article>

        <article class="category">
          <h3>Repostería</h3>
          <p>Cheesecakes, tartas, brownies, galletas y postres especiales.</p>
        </article>

        <article class="category">
          <h3>Catering</h3>
          <p>Propuestas gastronómicas para eventos sociales y corporativos.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- PRODUCTOS -->
  <section id="productos">
    <div class="container">

      <div class="section-header">
        <div>
          <div class="eyebrow">L’Orso</div>
          <h2>Nuestros productos</h2>
        </div>

        <p class="section-description">
          Una selección de nuestra producción.
        </p>
      </div>

      <div class="products">

        <article class="product">
          <div class="product-image"></div>
          <div class="product-info">
            <h3>Brioche</h3>
            <p>Bollos artesanales para restaurantes, cafeterías y servicio gastronómico.</p>
          </div>
        </article>

        <article class="product">
          <div class="product-image"></div>
          <div class="product-info">
            <h3>Rol de canela</h3>
            <p>Rol clásico y variedades especiales para cafeterías y venta individual.</p>
          </div>
        </article>

        <article class="product">
          <div class="product-image"></div>
          <div class="product-info">
            <h3>Cheesecake</h3>
            <p>Diferentes sabores y presentaciones para restaurantes y eventos.</p>
          </div>
        </article>

        <article class="product">
          <div class="product-image"></div>
          <div class="product-info">
            <h3>Galletas</h3>
            <p>Producción artesanal para cafeterías, eventos y pedidos especiales.</p>
          </div>
        </article>

        <article class="product">
          <div class="product-image"></div>
          <div class="product-info">
            <h3>Tartas</h3>
            <p>Tartas y postres desarrollados para servicio y ocasiones especiales.</p>
          </div>
        </article>

        <article class="product">
          <div class="product-image"></div>
          <div class="product-info">
            <h3>Brownies</h3>
            <p>Repostería individual para cafeterías, eventos y venta por pieza.</p>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios">
    <div class="container">

      <div class="eyebrow">Servicios</div>
      <h2>Repostería y catering</h2>

      <div class="services">

        <article class="service">
          <h3>Repostería</h3>

          <p>
            Producción para cafeterías, restaurantes,
            eventos y pedidos especiales.
            Desarrollamos formatos y sabores
            de acuerdo con las necesidades de cada cliente.
          </p>

          <a href="#cotizar" class="service-link">Solicitar información →</a>
        </article>

        <article class="service">
          <h3>Catering</h3>

          <p>
            Menús para eventos privados y corporativos,
            mesas de postres y propuestas gastronómicas
            personalizadas.
          </p>

          <a href="#cotizar" class="service-link">Cotizar evento →</a>
        </article>

      </div>
    </div>
  </section>

  <!-- COTIZACION -->
  <section id="cotizar" class="quote-section">
    <div class="container">

      <div class="quote-layout">

        <div class="quote-intro">
          <div class="eyebrow">Hablemos de tu evento</div>
          <h2>Solicita una cotización.</h2>

          <p>
            Cuéntanos qué necesitas y
            prepararemos una propuesta
            para tu evento.
          </p>
        </div>

        <form class="quote-form" id="quoteForm">

          <div class="form-group">
            <label>Nombre</label>
            <input type="text" id="nombre" required placeholder="Tu nombre">
          </div>

          <div class="form-group">
            <label>WhatsApp</label>
            <input type="tel" id="telefono" required placeholder="55 0000 0000">
          </div>

          <div class="form-group">
            <label>Fecha del evento</label>
            <input type="date" id="fecha" required>
          </div>

          <div class="form-group">
            <label>Número de personas</label>
            <input type="number" id="personas" min="1" placeholder="100">
          </div>

          <div class="form-group">
            <label>Servicio</label>
            <select id="servicio">
              <option>Catering</option>
              <option>Mesa de postres</option>
              <option>Repostería personalizada</option>
              <option>Evento corporativo</option>
              <option>Otro</option>
            </select>
          </div>

          <div class="form-group">
            <label>Ubicación</label>
            <input type="text" id="ubicacion" placeholder="Ciudad / zona">
          </div>

          <div class="form-group full">
            <label>Cuéntanos qué necesitas</label>
            <textarea id="mensaje" placeholder="Menú, productos, montaje, horario, etc."></textarea>
          </div>

          <div class="form-group full">
            <button type="submit" class="submit">
              Solicitar cotización por WhatsApp
            </button>
          </div>

        </form>
      </div>
    </div>
  </section>

  <!-- REDES -->
  <section>
    <div class="container">

      <div class="eyebrow">L’Orso en redes</div>
      <h2>Conoce nuestro trabajo.</h2>

      <div class="social-grid">

        <a href="https://www.instagram.com/lorso_catering/" target="_blank" class="social">
          <strong>Instagram</strong>
          <span>@lorso_catering</span>
        </a>

        <a href="#" class="social">
          <strong>Facebook</strong>
          <span>L’Orso Catering</span>
        </a>

        <a href="#cotizar" class="social">
          <strong>WhatsApp</strong>
          <span>Atención directa</span>
        </a>

      </div>
    </div>
  </section>

</main>

<footer>
  <div class="container footer-content">

    <div>
      <div class="logo">L’ORSO</div>
      <div class="footer-text">Panadería · Repostería · Catering</div>
    </div>

    <div class="footer-text">
      © 2026 L’Orso Catering
    </div>

  </div>
</footer>

<script>
  const form = document.getElementById("quoteForm");

  form.addEventListener("submit", function(event) {
    event.preventDefault();

    const nombre = document.getElementById("nombre").value;
    const telefono = document.getElementById("telefono").value;
    const fecha = document.getElementById("fecha").value;
    const personas = document.getElementById("personas").value;
    const servicio = document.getElementById("servicio").value;
    const ubicacion = document.getElementById("ubicacion").value;
    const mensaje = document.getElementById("mensaje").value;

    const texto =
      "Hola, quiero solicitar una cotización con L’Orso.%0A%0A" +
      "Nombre: " + encodeURIComponent(nombre) + "%0A" +
      "WhatsApp: " + encodeURIComponent(telefono) + "%0A" +
      "Fecha: " + encodeURIComponent(fecha) + "%0A" +
      "Personas: " + encodeURIComponent(personas) + "%0A" +
      "Servicio: " + encodeURIComponent(servicio) + "%0A" +
      "Ubicación: " + encodeURIComponent(ubicacion) + "%0A%0A" +
      "Detalles:%0A" +
      encodeURIComponent(mensaje);

    const numero = "5215644751647";

    window.open(
      "https://wa.me/" + numero + "?text=" + texto,
      "_blank"
    );
  });
</script>

</body>
</html>